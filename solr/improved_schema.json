{
    "add-field-type": [
        {
            "name": "review_text_en",
            "class": "solr.TextField",
            "indexed": true,
            "stored": true,
            "multiValued": false,
            "omitNorms": false,
            "analyzer": {
                "tokenizer": {"class": "solr.StandardTokenizerFactory"},
                "filters": [
                    {"class": "solr.EnglishPossessiveFilterFactory"},
                    {"class": "solr.LowerCaseFilterFactory"},
                    {"class": "solr.ASCIIFoldingFilterFactory", "preserveOriginal": false},
                    {"class": "solr.StopFilterFactory", "words": "stopwords_en.txt", "ignoreCase": true},
                    {"class": "solr.PorterStemFilterFactory"}
                ]
            }
        },
        {
            "name": "title_text",
            "class": "solr.TextField",
            "indexed": true,
            "stored": true,
            "multiValued": false,
            "omitNorms": false,
            "analyzer": {
                "tokenizer": {"class": "solr.StandardTokenizerFactory"},
                "filters": [
                    {"class": "solr.LowerCaseFilterFactory"},
                    {"class": "solr.ASCIIFoldingFilterFactory", "preserveOriginal": false}
                ]
            }
        }
    ],
    "add-field": [
        {"name": "perspective", "type": "string", "indexed": true, "stored": true, "docValues": true},
        {"name": "text", "type": "review_text_en"},
        {"name": "text_kind", "type": "string", "indexed": true, "stored": true, "docValues": true},
        {"name": "summary", "type": "review_text_en"},
        {"name": "quote", "type": "review_text_en"},
        {"name": "score", "type": "pfloat", "indexed": true, "stored": true, "docValues": true},
        {"name": "original_score", "type": "string", "indexed": false, "stored": true},
        {"name": "verdict", "type": "string", "indexed": true, "stored": true, "docValues": true},
        {"name": "is_spoiler", "type": "boolean", "indexed": true, "stored": true, "docValues": true},
        {"name": "top_critic", "type": "boolean", "indexed": true, "stored": true, "docValues": true},
        {"name": "author", "type": "string", "indexed": true, "stored": true, "docValues": true},
        {"name": "publication", "type": "string", "indexed": true, "stored": true, "docValues": true},
        {"name": "date", "type": "pdate", "indexed": true, "stored": true, "docValues": true},
        {"name": "url", "type": "string", "indexed": false, "stored": true},
        {"name": "word_count", "type": "pint", "indexed": true, "stored": true, "docValues": true},
        {"name": "language", "type": "string", "indexed": true, "stored": true, "docValues": true},
        {"name": "film_imdb_id", "type": "string", "indexed": true, "stored": true, "docValues": true},
        {"name": "film_wikidata_id", "type": "string", "indexed": true, "stored": true, "docValues": true},
        {"name": "film_title", "type": "title_text"},
        {"name": "film_year", "type": "pint", "indexed": true, "stored": true, "docValues": true},
        {"name": "film_genres", "type": "string", "indexed": true, "stored": true, "multiValued": true, "docValues": true},
        {"name": "film_plot_summary", "type": "review_text_en", "stored": false},
        {"name": "film_imdb_rating", "type": "pfloat", "indexed": true, "stored": true, "docValues": true},
        {"name": "film_tomatometer", "type": "pint", "indexed": true, "stored": true, "docValues": true},
        {"name": "film_audience_score", "type": "pint", "indexed": true, "stored": true, "docValues": true}
    ]
}
